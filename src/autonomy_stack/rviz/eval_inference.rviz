Visualization Manager:
  Class: ""
  Displays:
    - Name: Grid
      Class: rviz_default_plugins/Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50

    # ==========================================
    # INFERENCE MODE (Always On)
    # ==========================================
    - Name: EKF Odometry (Blue)
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Topic: /ekf/odometry
      Color: 0; 112; 255
      Keep: 200
      Shape: Arrow
      
    - Name: Pred BEV
      Class: rviz_default_plugins/Image
      Enabled: true
      Topic: /dashboard/pred/bev
      
    - Name: SLAM Occupancy
      Class: rviz_default_plugins/Image
      Enabled: true
      Topic: /dashboard/slam/occupancy

  Global Options:
    Fixed Frame: odom
